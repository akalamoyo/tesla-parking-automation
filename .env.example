from __future__ import annotations

import asyncio
import sys

from app.config import Settings
from app.parking import ManualParkingZoneProvider
from app.state import ParkingController
from app.tesla_client import TeslaClient


async def monitor_loop() -> None:
    settings = Settings()

    if not settings.has_tesla_credentials:
        raise RuntimeError(
            "Tesla credentials are missing. Set TESLA_EMAIL/TESLA_PASSWORD or TESLA_ACCESS_TOKEN in the environment."
        )

    tesla_client = TeslaClient(settings)
    zone_provider = ManualParkingZoneProvider(settings.local_parking_zones_json)
    controller = ParkingController(
        vehicle_status_provider=tesla_client,
        parking_provider=zone_provider,
        driving_speed_kmh_threshold=settings.driving_speed_kmh_threshold,
    )

    while True:
        state = await controller.run_once()
        print(f"Vehicle state: {state}")
        await asyncio.sleep(settings.polling_interval_seconds)


def main() -> None:
    try:
        asyncio.run(monitor_loop())
    except KeyboardInterrupt:
        print("Stopping Tesla parking automation.")
    except Exception as exc:  # pragma: no cover
        print(f"Application error: {exc}")
        sys.exit(1)


if __name__ == "__main__":
    main()
